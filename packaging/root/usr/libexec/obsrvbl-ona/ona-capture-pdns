# Captures DNS responses with tcpdump as root for the obsrvbl_ona service
# user, with a fixed argument vector. Does not read /opt/obsrvbl-ona/config,
# which that user can write.
#
# Usage: ona-capture-pdns <interface> <log-directory> <seconds> <pps-limit>

set -eu

. /usr/libexec/obsrvbl-ona/ona-capture-common.sh

if [ "$#" -ne 4 ]; then
    ona_die "usage: $0 <interface> <log-directory> <seconds> <pps-limit>"
fi

iface="$1"
seconds="$3"
pps_limit="$4"
ona_require_capture_iface "$iface"
ona_require_log_dir "$2" pdns
ona_require_integer "$seconds" 1 86400
ona_require_integer "$pps_limit" 1 1000000

# tcpdump takes -c as a C int, so check the product as well.
packet_limit=$(( seconds * pps_limit ))
ona_require_integer "$packet_limit" 1 2000000000

exec /usr/bin/tcpdump \
    -w "${ONA_LOG_PATH}/pdns_%s.pcap" \
    -i "$iface" \
    -s 0 \
    -c "$packet_limit" \
    -G "$seconds" \
    -U \
    -Z "$ONA_USER" \
    "udp src port 53"
