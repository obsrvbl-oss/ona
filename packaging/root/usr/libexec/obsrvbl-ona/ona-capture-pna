# Runs pna as root for the obsrvbl_ona service user, with a fixed argument
# vector. Does not read /opt/obsrvbl-ona/config, which that user can write.
#
# Usage: ona-capture-pna <interface> <log-directory> [network ...]

set -eu

. /usr/libexec/obsrvbl-ona/ona-capture-common.sh

if [ "$#" -lt 2 ]; then
    ona_die "usage: $0 <interface> <log-directory> [network ...]"
fi

iface="$1"
ona_require_iface "$iface"
ona_require_log_dir "$2" pna
shift 2
ona_build_bpf "$@"

ona_set_promisc "$iface"

exec /usr/libexec/obsrvbl-ona/pna \
    -i "$iface" \
    -N "$*" \
    -o "$ONA_LOG_PATH" \
    -Z "$ONA_USER" \
    "$ONA_BPF"
